{
  "name": "dottie-worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:performance": "vitest run --config vitest.performance.config.mts --disable-console-intercept",
    "build:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "npm run typecheck && npm run test:coverage && npm run test:performance && npm run build:check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@vitest/coverage-istanbul": "^5.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.159.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
