# Ceilings the Build workflow holds the Swift code to. A pull request that
# goes over one fails. When cleanup brings a real number down, lower the
# ceiling here in the same pull request so it can never creep back up.
#
# "unset" means the number is only reported, not enforced.
#
# If a number moves in a pull request that didn't touch Swift, GitHub
# updated Xcode or SwiftLint on its Macs: set the ceiling to the new number.

# Different compiler warnings in a Debug build of the app (mostly the known
# Swift 6 concurrency ones).
SWIFT_COMPILER_WARNING_BUDGET=62

# SwiftLint findings with the rules in .swiftlint.yml (46 one-letter names,
# 11 functions over 100 lines, 7 tangled functions, 2 files over 1500 lines
# when this was last lowered; the 32 force casts are gone).
SWIFTLINT_FINDING_BUDGET=66
